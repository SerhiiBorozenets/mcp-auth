  def backfill_digest(table, column, pk)
    return unless data_source_exists?(table) && column_exists?(table, column)

    say_with_time "Hashing #{table}.#{column} at rest" do
      updated = 0
      select_all("SELECT #{pk} AS pk, #{column} AS val FROM #{table}").each do |row|
        value = row['val']
        next if value.blank? || value.to_s.start_with?(PREFIX)

        digest = "#{PREFIX}#{Digest::SHA256.hexdigest(value.to_s)}"
        execute("UPDATE #{table} SET #{column} = #{quote(digest)} WHERE #{pk} = #{quote(row['pk'])}")
        updated += 1
      end
      updated
    end
  end
